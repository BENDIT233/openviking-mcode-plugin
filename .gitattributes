# Keep Windows launchers in CRLF so cmd/PowerShell parse them reliably.
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts and text stay LF.
*.sh text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Binary assets are never touched.
*.png binary
*.jpg binary
*.webp binary
