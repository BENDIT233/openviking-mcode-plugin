{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/openviking-hook.mjs\" session-start",
            "commandWindows": "\"${PLUGIN_ROOT}\\scripts\\ov-hook.cmd\" session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/openviking-hook.mjs\" user-prompt-submit",
            "commandWindows": "\"${PLUGIN_ROOT}\\scripts\\ov-hook.cmd\" user-prompt-submit",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "read|glob|grep",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/openviking-hook.mjs\" uri-guard",
            "commandWindows": "\"${PLUGIN_ROOT}\\scripts\\ov-hook.cmd\" uri-guard",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/openviking-hook.mjs\" stop",
            "commandWindows": "\"${PLUGIN_ROOT}\\scripts\\ov-hook.cmd\" stop",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/openviking-hook.mjs\" commit",
            "commandWindows": "\"${PLUGIN_ROOT}\\scripts\\ov-hook.cmd\" commit",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/openviking-hook.mjs\" post-compact",
            "commandWindows": "\"${PLUGIN_ROOT}\\scripts\\ov-hook.cmd\" post-compact",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/openviking-hook.mjs\" commit",
            "commandWindows": "\"${PLUGIN_ROOT}\\scripts\\ov-hook.cmd\" commit",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
